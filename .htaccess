# Relative rewrites work under /koken/ in XAMPP and at the domain root.
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [END]
RewriteRule ^urun/([a-z0-9]+(?:-[a-z0-9]+)*)(?:\.html)?/?$ product.php?slug=$1 [END]

ErrorDocument 404 /404.html
<If "%{HTTP_HOST} =~ m#^(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$#">
    ErrorDocument 404 /koken/404.html
</If>
