# Relative rewrites work under /koken/ in XAMPP and at the domain root.
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [END]
RewriteRule ^urun/([a-z0-9]+(?:-[a-z0-9]+)*)(?:\.html)?/?$ product.php?slug=$1 [END]

ErrorDocument 404 /404.html
<If "%{HTTP_HOST} =~ m#^(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$#">
    ErrorDocument 404 /koken/404.html
</If>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
    # Start with a short lifetime on the public HTTPS site only.
    Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on' && tolower(req('Host')) =~ m#^(www[.])?kokenfindik[.]com(:443)?$#"
</IfModule>
